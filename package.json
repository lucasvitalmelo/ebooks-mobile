  "dependencies": {
    "expo": "~58.0.17",
    "expo-constants": "~58.0.13",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.25",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "fast-xml-parser": "^5.11.2",
    "jszip": "^3.10.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@fontsource/comfortaa": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/literata": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/merriweather": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/quicksand": "^5.3.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "epubjs": "^0.3.93",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p reader-web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "reader:build": "vite build reader-web && node scripts/embed-reader.mjs",
    "postinstall": "npm run reader:build"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  }
