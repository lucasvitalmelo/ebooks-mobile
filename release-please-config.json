{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "node",
      "initial-version": "0.1.0",
      "bump-minor-pre-major": true,
      "include-component-in-tag": false,
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Funcionalidades"
        },
        {
          "type": "fix",
          "section": "Correções"
        },
        {
          "type": "refactor",
          "section": "Refatorações"
        },
        {
          "type": "docs",
          "section": "Documentação"
        },
        {
          "type": "chore",
          "section": "Manutenção",
          "hidden": true
        },
        {
          "type": "style",
          "section": "Estilo",
          "hidden": true
        },
        {
          "type": "test",
          "section": "Testes",
          "hidden": true
        },
        {
          "type": "ci",
          "section": "CI",
          "hidden": true
        }
      ],
      "extra-files": [
        {
          "type": "json",
          "path": "app.json",
          "jsonpath": "$.expo.version"
        }
      ]
    }
  }
}
